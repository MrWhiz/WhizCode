{
  "productName": "WhizCode",
  "version": "0.1.0",
  "identifier": "com.mrwhiz.whizcode",
  "build": {
    "beforeBuildCommand": "tsc -b && vite build",
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhizCode",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}

